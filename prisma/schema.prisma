generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Bid {
  id        String   @id @default(cuid())
  label     String
  link      String
  amount    Float
  clicks    Int      @default(0)
  timestamp DateTime @default(now())
}

model Metric {
  id         String   @id @default("global")
  totalViews Int      @default(0)
  createdAt  DateTime  @default(now())
}
